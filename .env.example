# AmneziaWG (awg-easy)
# Must match the WireGuard port set in the awg-easy web UI.
# AWG_PORT=51820

# WireGuard (wg-easy)
# WG_PORT=51830

# Multi-IP exit routing (shared by both services)
# Format: "gateway:external_ip,gateway:external_ip,..."
# Tables are auto-assigned: 100, 101, 102...
EXIT_ROUTES=172.100.0.1:1.2.3.4,172.101.0.1:2.3.4.5

# Owner of ./workdir/backups and the archives the backup service leaves there
# (it runs as root). Numeric UID/GID — user/group names don't exist inside
# the container.
# BACKUP_USER_ID=1000   (default)
# BACKUP_GROUP_ID=1000  (default)
