# Shared config for the remote/ scripts (tuna-adm.sh, tuna-backup.sh) —
# copy to tuna-adm.env and edit. tuna-adm.env is gitignored (host-specific).
#
# The scripts look for tuna-adm.env next to the path they were invoked as
# (symlinks are NOT resolved), so a project dir holding symlinks to the
# scripts can keep its own env beside them. Override the path with
# TUNA_ADM_ENV. Values here win over exported environment variables.

# SSH host (from your ~/.ssh/config) of the WireGuard server.
TUNA_ADM_SSH_HOST=your-ssh-tuna-host

## tuna-adm.sh — admin panel tunnels ########################################

# Local address the forwarded ports bind to.
# TUNA_ADM_LOCAL_IP=127.0.0.1

# AmneziaWG panel ports (local listen : remote panel).
# TUNA_ADM_AWG_LOCAL_PORT=51821
# TUNA_ADM_AWG_REMOTE_PORT=51821

# WireGuard panel ports (local listen : remote panel).
# TUNA_ADM_WG_LOCAL_PORT=51831
# TUNA_ADM_WG_REMOTE_PORT=51831

## tuna-backup.sh — backup download ##########################################

# Project dir on the server, relative to the SSH user's home.
# TUNA_ADM_REMOTE_DIR=shallow-tuna

# Where downloaded archives land. Relative paths resolve against the dir
# holding this env file; the first script argument overrides this and is
# resolved against the caller's CWD instead. Absolute paths work as-is.
# TUNA_ADM_BACKUP_DIR=backups
